# ---- Server ----
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/olive-wear

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
# first admin (created automatically on server start / seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@olivewear.com
ADMIN_PASSWORD=Admin@12345

# ---- Mail (OTP) ----
# Leave SMTP_USER empty in development: the OTP is then printed in the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Olive Wear <no-reply@olivewear.com>"
OTP_EXPIRY_MINUTES=10

# ---- Shop ----
MAX_QTY_PER_ORDER=10

# ---- Razorpay (use test-mode credentials from your Razorpay dashboard) ----
RAZORPAY_KEY_ID=rzp_test_U2L9k1irzXhVk8
RAZORPAY_KEY_SECRET=fanKF010seozVes9ey2z9UBr
